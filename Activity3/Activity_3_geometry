# activity_3_3d_geometry.py
# Activity 3: 3D Geometry, Distance Metrics & Bounding Volumes (Pygame)
# Verifies Example 3 (d=3) and Example 5 (center=(-2,3,-1), r=sqrt(8))
# Visualizes 100 random 3D objects with broad-phase collision detection.

import pygame, math, random, sys

pygame.init()
W, H = 900, 650
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption("Activity 3: 3D Geometry & Bounding Volumes")
clock = pygame.time.Clock()
font = pygame.font.Font(None, 22)
big_font = pygame.font.Font(None, 30)

# =========================================================
# CORE MATH CLASSES (unchanged logic from the manual)
# =========================================================
class Point3D:
    def __init__(self, x, y, z):
        self.x, self.y, self.z = x, y, z
    def distance_to(self, o):
        return math.sqrt((self.x-o.x)**2 + (self.y-o.y)**2 + (self.z-o.z)**2)
    def distance_sq(self, o):
        return (self.x-o.x)**2 + (self.y-o.y)**2 + (self.z-o.z)**2
    def __sub__(self, o): return Point3D(self.x-o.x, self.y-o.y, self.z-o.z)
    def dot(self, o):     return self.x*o.x + self.y*o.y + self.z*o.z
    def cross(self, o):
        return Point3D(self.y*o.z - self.z*o.y,
                       self.z*o.x - self.x*o.z,
                       self.x*o.y - self.y*o.x)
    def octant(self):
        return (1 if self.x >= 0 else -1,
                1 if self.y >= 0 else -1,
                1 if self.z >= 0 else -1)

class Sphere3D:
    def __init__(self, center, radius):
        self.center, self.radius = center, radius
    def contains_point(self, p):
        return self.center.distance_sq(p) <= self.radius ** 2
    def intersects_sphere(self, other):
        r = self.radius + other.radius
        return self.center.distance_sq(other.center) <= r * r

class AABB:
    def __init__(self, min_pt, max_pt):
        self.min_pt, self.max_pt = min_pt, max_pt
    def intersects(self, o):
        return (self.min_pt.x <= o.max_pt.x and self.max_pt.x >= o.min_pt.x and
                self.min_pt.y <= o.max_pt.y and self.max_pt.y >= o.min_pt.y and
                self.min_pt.z <= o.max_pt.z and self.max_pt.z >= o.min_pt.z)

# =========================================================
# VERIFICATIONS (printed to console AND shown on screen)
# =========================================================
P = Point3D(2, -1, 7)
Q = Point3D(1, -3, 5)
dist_PQ = P.distance_to(Q)

cx, cy, cz = -4/2, 6/2, -2/2          # completing the square
r_sq = cx*cx + cy*cy + cz*cz - 6
radius = math.sqrt(r_sq)

print(f"[Example 3] Distance P->Q = {dist_PQ:.4f} (expected 3.0)")
print(f"[Example 5] Center=({cx},{cy},{cz}) Radius=sqrt({r_sq})={radius:.4f}")

# =========================================================
# BUILD 100 RANDOM 3D OBJECTS
# =========================================================
random.seed(7)
SPREAD = 30
spheres, boxes = [], []
for _ in range(100):
    c = Point3D(random.uniform(-SPREAD, SPREAD),
                random.uniform(-SPREAD, SPREAD),
                random.uniform(-SPREAD, SPREAD))
    r = random.uniform(1.5, 4.0)
    spheres.append(Sphere3D(c, r))
    boxes.append(AABB(Point3D(c.x - r, c.y - r, c.z - r),
                      Point3D(c.x + r, c.y + r, c.z + r)))

# Broad-phase pairwise intersections
def compute_collisions():
    s_hits, b_hits = set(), set()
    for i in range(len(spheres)):
        for j in range(i + 1, len(spheres)):
            if spheres[i].intersects_sphere(spheres[j]):
                s_hits.add(i); s_hits.add(j)
    for i in range(len(boxes)):
        for j in range(i + 1, len(boxes)):
            if boxes[i].intersects(boxes[j]):
                b_hits.add(i); b_hits.add(j)
    return s_hits, b_hits

sphere_hits, aabb_hits = compute_collisions()
print(f"Sphere-Sphere overlaps: {len(sphere_hits)} objects")
print(f"AABB-AABB overlaps:     {len(aabb_hits)} objects")

# =========================================================
# 3D -> 2D ISOMETRIC PROJECTION
# =========================================================
def project(p, rot_y=0.6, rot_x=0.35):
    # Rotate around Y
    cy_, sy_ = math.cos(rot_y), math.sin(rot_y)
    x = p.x * cy_ + p.z * sy_
    z = -p.x * sy_ + p.z * cy_
    y = p.y
    # Rotate around X
    cx_, sx_ = math.cos(rot_x), math.sin(rot_x)
    y2 = y * cx_ - z * sx_
    z2 = y * sx_ + z * cx_
    # Simple perspective
    dist = z2 + 60
    if dist < 1: dist = 1
    scale = 400 / dist
    return (int(W/2 + x * scale * 1.6),
            int(H/2 - y2 * scale * 1.6))

# =========================================================
# MODE CONTROL
# =========================================================
mode = 1  # 1 = Spheres, 2 = AABBs, 3 = Math Verification
auto_rotate = True
rot_y = 0.6

# =========================================================
# MAIN LOOP
# =========================================================
running = True
while running:
    dt = clock.tick(60) / 1000.0
    for e in pygame.event.get():
        if e.type == pygame.QUIT: running = False
        if e.type == pygame.KEYDOWN:
            if e.key == pygame.K_1: mode = 1
            if e.key == pygame.K_2: mode = 2
            if e.key == pygame.K_3: mode = 3
            if e.key == pygame.K_SPACE: auto_rotate = not auto_rotate

    if auto_rotate:
        rot_y += 0.4 * dt

    screen.fill((10, 12, 22))

    # -------- Mode 1: Bounding Spheres --------
    if mode == 1:
        # Draw non-colliding first
        for i, s in enumerate(spheres):
            px, py = project(s.center, rot_y)
            r_px = max(3, int(s.radius * 6))
            color = (255, 90, 90) if i in sphere_hits else (70, 140, 220)
            # Glow
            glow = pygame.Surface((r_px*2+8, r_px*2+8), pygame.SRCALPHA)
            pygame.draw.circle(glow, (*color, 60), (r_px+4, r_px+4), r_px+4)
            screen.blit(glow, (px - r_px - 4, py - r_px - 4))
            pygame.draw.circle(screen, color, (px, py), r_px)
            pygame.draw.circle(screen, (240, 240, 240), (px, py), r_px, 1)

    # -------- Mode 2: AABBs --------
    elif mode == 2:
        # Sort by depth so nearer boxes draw on top
        order = sorted(range(len(boxes)),
                       key=lambda i: project(boxes[i].min_pt, rot_y)[1])
        for i in order:
            b = boxes[i]
            # 8 corners projected
            corners = [
                Point3D(b.min_pt.x, b.min_pt.y, b.min_pt.z),
                Point3D(b.max_pt.x, b.min_pt.y, b.min_pt.z),
                Point3D(b.max_pt.x, b.max_pt.y, b.min_pt.z),
                Point3D(b.min_pt.x, b.max_pt.y, b.min_pt.z),
                Point3D(b.min_pt.x, b.min_pt.y, b.max_pt.z),
                Point3D(b.max_pt.x, b.min_pt.y, b.max_pt.z),
                Point3D(b.max_pt.x, b.max_pt.y, b.max_pt.z),
                Point3D(b.min_pt.x, b.max_pt.y, b.max_pt.z),
            ]
            pts = [project(c, rot_y) for c in corners]
            color = (255, 200, 60) if i in aabb_hits else (100, 220, 180)
            edges = [(0,1),(1,2),(2,3),(3,0),(4,5),(5,6),(6,7),(7,4),
                     (0,4),(1,5),(2,6),(3,7)]
            for a, b_ in edges:
                pygame.draw.line(screen, color, pts[a], pts[b_], 1)

    # -------- Mode 3: Math Verification Panel --------
    elif mode == 3:
        screen.blit(big_font.render("Mathematical Verification", True, (255, 230, 120)), (30, 30))
        lines = [
            "Example 3 (Slide verification):",
            f"   P = (2, -1, 7),  Q = (1, -3, 5)",
            f"   d = sqrt((1-2)^2 + (-3+1)^2 + (5-7)^2)",
            f"   d = sqrt(1 + 4 + 4) = sqrt(9) = {dist_PQ:.4f}  ✓",
            "",
            "Example 5 (Sphere from general equation):",
            "   x^2 + y^2 + z^2 + 4x - 6y + 2z + 6 = 0",
            "   Complete the squares:",
            "   (x+2)^2 + (y-3)^2 + (z+1)^2 = 8",
            f"   Center = ({cx:.0f}, {cy:.0f}, {cz:.0f})",
            f"   Radius = sqrt(8) = {radius:.4f}  ✓",
            "",
            "Broad-phase stress test (100 objects):",
            f"   Sphere-Sphere overlaps : {len(sphere_hits)} objects",
            f"   AABB-AABB overlaps     : {len(aabb_hits)} objects",
            "",
            "Optimization insight:",
            "   Compare squared distances for sphere tests",
            "   to avoid the expensive math.sqrt() call.",
        ]
        for i, line in enumerate(lines):
            screen.blit(font.render(line, True, (220, 230, 245)), (30, 90 + i * 24))

    # -------- HUD --------
    mode_names = {1: "Bounding Spheres", 2: "AABB Boxes", 3: "Math Proof"}
    screen.blit(font.render(f"Mode: {mode_names[mode]}", True, (240, 240, 240)), (15, 15))
    screen.blit(font.render("Keys: [1] Spheres  [2] AABBs  [3] Math  [SPACE] Pause rotation",
                            True, (170, 180, 200)), (15, H - 28))
    # Collision counters
    screen.blit(font.render(f"Sphere overlaps: {len(sphere_hits)}", True, (255, 130, 130)),
                (W - 240, 15))
    screen.blit(font.render(f"AABB overlaps: {len(aabb_hits)}", True, (255, 210, 100)),
                (W - 240, 40))
    screen.blit(font.render(f"FPS: {int(clock.get_fps())}", True, (150, 200, 255)),
                (W - 240, 65))

    pygame.display.flip()

pygame.quit()
sys.exit()
