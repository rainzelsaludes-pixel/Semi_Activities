"""
Activity 2: Interactive Game Architecture: Game Loop, Sprites, & Collision
Features: Player sprite, roaming obstacles, collision detection, HUD,
          impact particles with alpha fading.
Controls: Arrows=Move, ESC=Quit, R=Restart
"""

import pygame
import random
import sys
import math

pygame.init()
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption('Activity 2: Sprite System & Collision Arena')
clock = pygame.time.Clock()
font = pygame.font.Font(None, 36)
small_font = pygame.font.Font(None, 22)

# ============================================================
# PARTICLE SYSTEM (Task 2.4)
# ============================================================

class Particle(pygame.sprite.Sprite):
    """Translucent impact particle with alpha fading."""
    def __init__(self, x, y, color=(255, 200, 50)):
        super().__init__()
        size = random.randint(4, 10)
        self.image = pygame.Surface((size, size), pygame.SRCALPHA)
        self.original_color = color
        self.alpha = 255
        self.radius = size // 2
        pygame.draw.circle(self.image, (*color, self.alpha),
                          (self.radius, self.radius), self.radius)
        self.rect = self.image.get_rect(center=(x, y))
        self.pos = pygame.Vector2(x, y)
        self.vel = pygame.Vector2(
            random.uniform(-150, 150),
            random.uniform(-200, -50)
        )
        self.life = 1.0
        self.decay = random.uniform(1.5, 3.0)
        self.gravity = 300

    def update(self, dt):
        self.vel.y += self.gravity * dt
        self.pos += self.vel * dt
        self.life -= self.decay * dt
        if self.life <= 0:
            self.kill()
            return
        self.alpha = max(0, int(255 * self.life))
        size = max(1, int(self.radius * 2 * self.life))
        self.image = pygame.Surface((size, size), pygame.SRCALPHA)
        pygame.draw.circle(self.image, (*self.original_color, self.alpha),
                          (size // 2, size // 2), size // 2)
        self.rect = self.image.get_rect(center=(int(self.pos.x), int(self.pos.y)))

# ============================================================
# PLAYER SPRITE (Task 2.1, 2.2)
# ============================================================

class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((44, 44), pygame.SRCALPHA)
        pygame.draw.circle(self.image, (44, 94, 138), (22, 22), 20)
        pygame.draw.circle(self.image, (100, 160, 220), (16, 16), 8)
        pygame.draw.circle(self.image, (255, 255, 255), (22, 22), 20, 2)
        self.rect = self.image.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2))
        self.speed = 320  # pixels per second
        self.health = 100
        self.max_health = 100
        self.invulnerable = 0.0
        self.hit_flash = 0.0

    def update(self, dt):
        keys = pygame.key.get_pressed()
        dx = dy = 0
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            dx -= 1
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            dx += 1
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            dy -= 1
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            dy += 1

        # Normalize diagonal
        if dx != 0 and dy != 0:
            dx *= 0.7071
            dy *= 0.7071

        self.rect.x += int(dx * self.speed * dt)
        self.rect.y += int(dy * self.speed * dt)

        # Screen boundary clamping
        self.rect.left = max(0, self.rect.left)
        self.rect.right = min(SCREEN_WIDTH, self.rect.right)
        self.rect.top = max(0, self.rect.top)
        self.rect.bottom = min(SCREEN_HEIGHT, self.rect.bottom)

        if self.invulnerable > 0:
            self.invulnerable -= dt
        if self.hit_flash > 0:
            self.hit_flash -= dt

    def take_damage(self, amount):
        if self.invulnerable <= 0:
            self.health -= amount
            self.invulnerable = 1.0
            self.hit_flash = 0.3
            return True
        return False

    def draw_hit_flash(self, surface):
        if self.hit_flash > 0:
            flash = pygame.Surface((self.rect.width, self.rect.height), pygame.SRCALPHA)
            alpha = int(200 * (self.hit_flash / 0.3))
            pygame.draw.circle(flash, (255, 50, 50, alpha),
                             (self.rect.width // 2, self.rect.height // 2), 22)
            surface.blit(flash, self.rect.topleft)

# ============================================================
# TARGET / OBSTACLE SPRITES (Task 2.1)
# ============================================================

class Target(pygame.sprite.Sprite):
    """Collectible target that gives score."""
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((28, 28), pygame.SRCALPHA)
        pygame.draw.circle(self.image, (50, 220, 100), (14, 14), 13)
        pygame.draw.circle(self.image, (255, 255, 255), (14, 14), 13, 2)
        pygame.draw.circle(self.image, (255, 255, 255), (14, 14), 5)
        self.rect = self.image.get_rect(
            topleft=(random.randint(50, SCREEN_WIDTH - 80),
                     random.randint(50, SCREEN_HEIGHT - 80)))
        self.pulse = 0.0

    def update(self, dt):
        self.pulse += dt * 5


class Obstacle(pygame.sprite.Sprite):
    """Roaming obstacle that damages the player."""
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((34, 34), pygame.SRCALPHA)
        pygame.draw.rect(self.image, (220, 50, 50), (0, 0, 34, 34),
                        border_radius=6)
        pygame.draw.rect(self.image, (255, 255, 255), (0, 0, 34, 34),
                        2, border_radius=6)
        pygame.draw.line(self.image, (255, 255, 255), (8, 8), (26, 26), 2)
        pygame.draw.line(self.image, (255, 255, 255), (26, 8), (8, 26), 2)
        self.rect = self.image.get_rect(
            topleft=(random.randint(50, SCREEN_WIDTH - 80),
                     random.randint(50, SCREEN_HEIGHT - 80)))
        self.vel = pygame.Vector2(
            random.choice([-1, 1]) * random.uniform(60, 140),
            random.choice([-1, 1]) * random.uniform(60, 140)
        )
        self.respawn_timer = 0.0

    def update(self, dt):
        self.rect.x += int(self.vel.x * dt)
        self.rect.y += int(self.vel.y * dt)

        # Bounce off walls
        if self.rect.left <= 0 or self.rect.right >= SCREEN_WIDTH:
            self.vel.x = -self.vel.x
            self.rect.x = max(0, min(self.rect.x, SCREEN_WIDTH - self.rect.width))
        if self.rect.top <= 0 or self.rect.bottom >= SCREEN_HEIGHT:
            self.vel.y = -self.vel.y
            self.rect.y = max(0, min(self.rect.y, SCREEN_HEIGHT - self.rect.height))

# ============================================================
# GAME CLASS (Game Loop Lifecycle)
# ============================================================

class Game:
    def __init__(self):
        self.reset()

    def reset(self):
        # Sprite groups
        self.all_sprites = pygame.sprite.Group()
        self.obstacles = pygame.sprite.Group()
        self.targets = pygame.sprite.Group()
        self.particles = pygame.sprite.Group()

        self.player = Player()
        self.all_sprites.add(self.player)

        for _ in range(5):
            obs = Obstacle()
            self.obstacles.add(obs)
            self.all_sprites.add(obs)

        for _ in range(3):
            tgt = Target()
            self.targets.add(tgt)
            self.all_sprites.add(tgt)

        self.score = 0
        self.state = "PLAYING"  # PLAYING | GAME_OVER

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    return False
                if event.key == pygame.K_r:
                    self.reset()
        return True

    def update(self, dt):
        if self.state == "GAME_OVER":
            self.particles.update(dt)
            return

        # Update player
        self.player.update(dt)

        # Update obstacles
        for obs in self.obstacles:
            obs.update(dt)

        # Update targets (pulse)
        for tgt in self.targets:
            tgt.update(dt)

        # Update particles
        self.particles.update(dt)

        # --- Collision: Player vs Targets (spritecollide) ---
        hit_targets = pygame.sprite.spritecollide(
            self.player, self.targets, True,
            pygame.sprite.collide_circle
        )
        for tgt in hit_targets:
            self.score += 10
            self.spawn_particles(tgt.rect.center, (50, 220, 100))
            # Respawn a new target
            new_tgt = Target()
            self.targets.add(new_tgt)
            self.all_sprites.add(new_tgt)

        # --- Collision: Player vs Obstacles ---
        hit_obstacles = pygame.sprite.spritecollide(
            self.player, self.obstacles, False,
            pygame.sprite.collide_rect
        )
        for obs in hit_obstacles:
            if self.player.take_damage(20):
                self.spawn_particles(self.player.rect.center, (255, 80, 80))
                # Knockback obstacle
                obs.vel = -obs.vel

        # Check death
        if self.player.health <= 0:
            self.player.health = 0
            self.state = "GAME_OVER"
            self.spawn_particles(self.player.rect.center, (255, 50, 50), count=30)

    def spawn_particles(self, pos, color, count=10):
        for _ in range(count):
            p = Particle(pos[0], pos[1], color)
            self.particles.add(p)

    def draw_hud(self, surface):
        # Score
        score_txt = font.render(f"Score: {self.score}", True, (255, 255, 255))
        surface.blit(score_txt, (10, 10))

        # Health bar
        bar_x, bar_y = 10, 50
        bar_w, bar_h = 200, 22
        pygame.draw.rect(surface, (60, 60, 60), (bar_x, bar_y, bar_w, bar_h),
                        border_radius=4)
        hp_ratio = max(0, self.player.health / self.player.max_health)
        hp_color = (50, 220, 100) if hp_ratio > 0.5 else \
                   (255, 200, 50) if hp_ratio > 0.25 else (220, 50, 50)
        pygame.draw.rect(surface, hp_color,
                        (bar_x, bar_y, int(bar_w * hp_ratio), bar_h),
                        border_radius=4)
        pygame.draw.rect(surface, (255, 255, 255),
                        (bar_x, bar_y, bar_w, bar_h), 2, border_radius=4)
        hp_txt = small_font.render(f"HP: {self.player.health}", True, (255, 255, 255))
        surface.blit(hp_txt, (bar_x + bar_w + 10, bar_y + 2))

        # FPS
        fps_txt = small_font.render(f"FPS: {int(clock.get_fps())}", True, (150, 255, 150))
        surface.blit(fps_txt, (SCREEN_WIDTH - 100, 10))

        # Controls
        ctrl = small_font.render("Arrows/WASD=Move  R=Restart  ESC=Quit",
                                 True, (180, 180, 180))
        surface.blit(ctrl, (10, SCREEN_HEIGHT - 25))

        if self.state == "GAME_OVER":
            over = font.render("GAME OVER - Press R to Restart", True, (255, 80, 80))
            rect = over.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2))
            surface.blit(over, rect)

    def draw(self, surface):
        surface.fill((20, 22, 30))

        # Grid background
        for x in range(0, SCREEN_WIDTH, 40):
            pygame.draw.line(surface, (28, 30, 38), (x, 0), (x, SCREEN_HEIGHT))
        for y in range(0, SCREEN_HEIGHT, 40):
            pygame.draw.line(surface, (28, 30, 38), (0, y), (SCREEN_WIDTH, y))

        self.all_sprites.draw(surface)
        self.player.draw_hit_flash(surface)
        self.particles.draw(surface)
        self.draw_hud(surface)

    def run(self):
        running = True
        while running:
            dt = clock.tick(60) / 1000.0
            running = self.handle_events()
            self.update(dt)
            self.draw(screen)
            pygame.display.flip()
        pygame.quit()
        sys.exit()


if __name__ == "__main__":
    Game().run()
