import pygame
import math
import sys

pygame.init()
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption('Activity 1: 2D Animation, Tweening & Morphing Engine')
clock = pygame.time.Clock()
font = pygame.font.Font(None, 28)
small_font = pygame.font.Font(None, 20)

# ============================================================
# INTERPOLATION HELPERS
# ============================================================

def lerp(a, b, t):
    """Linear interpolation between a and b."""
    return a + (b - a) * t

def lerp_point(p1, p2, t):
    """LERP between two 2D points."""
    return (lerp(p1[0], p2[0], t), lerp(p1[1], p2[1], t))

def ease_in(t):
    """Ease-in (quadratic)."""
    return t * t

def ease_out(t):
    """Ease-out (quadratic)."""
    return t * (2 - t)

def ease_in_out(t):
    """Smooth ease-in-out."""
    if t < 0.5:
        return 2 * t * t
    return -1 + (4 - 2 * t) * t

# ============================================================
# TASK 1.1: TWEENING ALONG A MULTI-POINT SPLINE PATH
# ============================================================

class TweenPath:
    """Sprite moving along a multi-point path with LERP and easing."""
    def __init__(self):
        self.waypoints = [
            (100, 500), (200, 200), (350, 450),
            (500, 150), (650, 400), (750, 250)
        ]
        self.t = 0.0
        self.speed = 0.005
        self.duration = 6.0  # seconds for full path
        self.elapsed = 0.0
        self.radius = 15
        self.trail = []
        self.easing_mode = 0  # 0=linear, 1=ease_in, 2=ease_out, 3=ease_in_out
        self.easing_names = ["LINEAR", "EASE-IN", "EASE-OUT", "EASE-IN-OUT"]

    def update(self, dt):
        self.elapsed += dt
        raw_t = min(self.elapsed / self.duration, 1.0)
        
        # Apply easing based on mode
        if self.easing_mode == 0:
            t = raw_t
        elif self.easing_mode == 1:
            t = ease_in(raw_t)
        elif self.easing_mode == 2:
            t = ease_out(raw_t)
        else:
            t = ease_in_out(raw_t)
        
        # Find segment
        n = len(self.waypoints) - 1
        seg = min(int(t * n), n - 1)
        local_t = (t * n) - seg
        
        p1 = self.waypoints[seg]
        p2 = self.waypoints[seg + 1]
        pos = lerp_point(p1, p2, local_t)
        
        self.trail.append(pos)
        if len(self.trail) > 60:
            self.trail.pop(0)
        
        if raw_t >= 1.0:
            self.elapsed = 0.0
            self.trail.clear()
        
        return pos

    def draw(self, surface):
        # Draw path
        for i in range(len(self.waypoints) - 1):
            pygame.draw.line(surface, (60, 60, 80),
                           self.waypoints[i], self.waypoints[i + 1], 1)
        # Draw waypoints
        for wp in self.waypoints:
            pygame.draw.circle(surface, (100, 100, 120), wp, 4)
        
        # Draw trail
        for i, p in enumerate(self.trail):
            alpha = int(255 * (i / len(self.trail))) if self.trail else 0
            color = (44, 94, 138)
            r = max(1, int(self.radius * (i / len(self.trail))))
            if r > 0:
                pygame.draw.circle(surface, color, (int(p[0]), int(p[1])), r)

    def get_position(self):
        n = len(self.waypoints) - 1
        raw_t = min(self.elapsed / self.duration, 1.0)
        if self.easing_mode == 0:
            t = raw_t
        elif self.easing_mode == 1:
            t = ease_in(raw_t)
        elif self.easing_mode == 2:
            t = ease_out(raw_t)
        else:
            t = ease_in_out(raw_t)
        seg = min(int(t * n), n - 1)
        local_t = (t * n) - seg
        return lerp_point(self.waypoints[seg], self.waypoints[seg + 1], local_t)

