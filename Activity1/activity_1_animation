# TASK 1.2: POLYGON MORPHING (Triangle -> Quadrilateral)
# ============================================================

class PolygonMorph:
    """
    Morphs a triangle into a quadrilateral.
    Vertex correspondence rule: split an edge on the simpler polygon
    so both keyframes have identical vertex count.
    Triangle (3 verts) gets a 4th vertex on one edge (duplicate),
    making 4 control vertices for both.
    """
    def __init__(self):
        # Start: Triangle with 4 control points (one edge split)
        # Triangle vertices: A(200,100), B(400,400), C(150,400)
        # Split edge B-C at midpoint M(275,400)
        self.start = [
            (200, 100),   # A - apex
            (400, 400),   # B - right base
            (275, 400),   # M - midpoint of B-C (split vertex)
            (150, 400),   # C - left base
        ]
        # End: Quadrilateral (4 vertices)
        self.end = [
            (250, 80),    # top
            (500, 200),   # right
            (400, 450),   # bottom-right
            (100, 350),   # bottom-left
        ]
        self.t = 0.0
        self.direction = 1
        self.speed = 0.008

    def update(self):
        self.t += self.speed * self.direction
        if self.t >= 1.0:
            self.t = 1.0
            self.direction = -1
        elif self.t <= 0.0:
            self.t = 0.0
            self.direction = 1

    def get_vertices(self):
        return [lerp_point(self.start[i], self.end[i], self.t)
                for i in range(4)]

    def draw(self, surface):
        verts = self.get_vertices()
        # Draw filled polygon with alpha
        color = (
            int(lerp(44, 200, self.t)),
            int(lerp(94, 100, self.t)),
            int(lerp(138, 50, self.t))
        )
        pygame.draw.polygon(surface, color, verts)
        pygame.draw.polygon(surface, (255, 255, 255), verts, 2)
        
        # Draw vertices
        for v in verts:
            pygame.draw.circle(surface, (255, 255, 0), (int(v[0]), int(v[1])), 5)
        
        # Labels
        labels = ["A", "B", "M", "C"]
        for i, v in enumerate(verts):
            txt = small_font.render(labels[i], True, (255, 255, 255))
            surface.blit(txt, (v[0] + 8, v[1] - 8))

